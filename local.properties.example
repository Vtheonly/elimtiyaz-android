# Local development environment.
#
# Copy this file to `local.properties` and fill in your own values.
# NEVER commit `local.properties` — it is git-ignored.

# Android SDK location (required). Set to the absolute path on your dev machine.
sdk.dir=/home/your-user/Android/Sdk

# Supabase credentials (optional). When both keys are absent, the app falls back
# to a built-in mock repository so the UI is fully demoable offline.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Groq / OpenRouter keys for the AI Assistant feature. When absent,
# the AI screen returns canned responses.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Build settings
org.gradle.jvmargs=-Xmx4096m
