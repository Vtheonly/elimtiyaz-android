# El-Imtiyaz Android app — environment template
#
# Copy to .env (gitignored) and fill in the values from the canonical
# credential sheet: docs/operations/credentials.md in the hub repository
# (AgentGithubUplaod). The Supabase URL below is the REAL production
# value (public client identifier — protected by RLS, not by secrecy).
# The anon key + publishable key are placeholders; pick one — Android
# accepts either via BuildConfig.SUPABASE_ANON_KEY.ifBlank { SUPABASE_PUBLISHABLE_KEY }.
#
# T-107 / MIG-KEYS-201 (2026-09-01, ADR-009 — dual acceptance, publishable-
# preferred): SUPABASE_PUBLISHABLE_KEY is now the PREFERRED slot. Fill it
# with the project's sb_publishable_... value from the hub credentials sheet
# (docs/operations/credentials.md section 8 in AgentGithubUplaod) or the
# Supabase dashboard (Project Settings -> API). The legacy anon JWT stays
# valid as a rollback; the key VALUES stay out of this repo by design
# (T-064/SEC-005: no committed APK-path credentials).
#
# NEVER put the service_role key, secret key, or access token in this
# file — they would ship inside the APK and bypass RLS.

# ── Supabase (shared backend — same project as desktop + website) ──────────
SUPABASE_URL=https://hkvkefubghbbotgnteir.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://hkvkefubghbbotgnteir.supabase.co/auth/v1/.well-known/jwks.json

# ── Firebase (FCM push notifications — shared with the website) ─────────────
# Project: elimtiyaz-android (Firebase console). The google-services.json
# file (downloaded from Firebase console) is the canonical source for
# these — Gradle's secrets-plugin reads it at build time. Do NOT
# duplicate Firebase values here if google-services.json is in app/.
