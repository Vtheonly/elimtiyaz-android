# El-Imtiyaz Android — Environment Variables
# Copy this file to .env and fill in your Supabase credentials.
# The secrets-gradle-plugin reads .env at build time and injects values
# as BuildConfig fields (BuildConfig.SUPABASE_URL, BuildConfig.SUPABASE_ANON_KEY).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
