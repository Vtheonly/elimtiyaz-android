# El-Imtiyaz Android app — environment template
#
# This file doubles as the secrets-gradle-plugin's DEFAULT properties source
# (defaultPropertiesFileName in app/build.gradle.kts): a fresh clone with NO
# .env at all builds — and boots against the REAL backend — straight from
# these values. Run scripts/setup-env.sh to create a gitignored .env with
# the same public values (or a custom project's).
#
# The values below are PUBLIC CLIENT IDENTIFIERS (ADR-009): the Supabase
# URL + sb_publishable_… key identify the project, they do NOT grant any
# access beyond what Row-Level Security allows anonymous callers (the same
# values are committed in the website's public-config.ts). They are NOT
# secrets — that is precisely why they may live here.
#
# ADR-009 dual acceptance, publishable-preferred: the app reads
# BuildConfig.SUPABASE_ANON_KEY.ifBlank { SUPABASE_PUBLISHABLE_KEY }. Both
# slots below carry the publishable key — an EMPTY slot makes the plugin
# emit a bare `SUPABASE_ANON_KEY = ;` literal that BREAKS COMPILATION
# (the AGENTS.md §8.1 quirk; root cause of the 133rd-session red baseline).
# To roll back to the legacy anon JWT, put that JWT in BOTH slots.
#
# Project history: vebfehrpzajhstyhinnw is the CURRENT live project (since
# the 2026-09-17 switch — hub credentials sheet §1). The previous project
# hkvkefubghbbotgnteir is retired; its values must NOT be restored here.
#
# NEVER put the service_role key, an sb_secret_… key, or an sbp_ access
# token in this file — they would ship inside the APK and bypass RLS.
# scripts/setup-env.sh refuses to write any value of those classes.

# ── Supabase (shared backend — same project as desktop + website) ──────────
SUPABASE_URL=https://vebfehrpzajhstyhinnw.supabase.co
SUPABASE_ANON_KEY=sb_publishable_IPUtQMYQzr1wNnfGTcl5MA_wuz3RUdg
SUPABASE_PUBLISHABLE_KEY=sb_publishable_IPUtQMYQzr1wNnfGTcl5MA_wuz3RUdg
SUPABASE_JWKS_URL=https://vebfehrpzajhstyhinnw.supabase.co/auth/v1/.well-known/jwks.json

# ── Firebase (FCM push notifications — shared with the website) ─────────────
# Project: elimtiyaz-android (Firebase console). The google-services.json
# file (downloaded from Firebase console) is the canonical source for
# these — Gradle's secrets-plugin reads it at build time. Do NOT
# duplicate Firebase values here if google-services.json is in app/.
